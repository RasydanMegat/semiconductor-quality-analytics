/// One row per anonymous measurement; status and bin limits use the full source.
table Measurement
	lineageTag: f19765f9-b57a-4e3b-b698-2a66c83f8966

	/// Full-source variable measurements; does not recalculate status for a date selection.
	measure 'Variable Measurements' = COALESCE(CALCULATE(COUNTROWS('Measurement'), REMOVEFILTERS(), 'Measurement'[Global Status] = "Variable"), 0)
		formatString: #,##0
		displayFolder: Analysis
		lineageTag: a9a6da03-5bfe-4d35-a815-e99770e4c018

	/// Full-source constant measurements, excluding missing cells.
	measure 'Constant Measurements' = COALESCE(CALCULATE(COUNTROWS('Measurement'), REMOVEFILTERS(), 'Measurement'[Global Status] = "Constant"), 0)
		formatString: #,##0
		displayFolder: Analysis
		lineageTag: 2979bdf1-b21c-4de4-ba51-921275e904b1

	/// Measurements with no numeric values anywhere in the full source.
	measure 'All Missing Measurements' = COALESCE(CALCULATE(COUNTROWS('Measurement'), REMOVEFILTERS(), 'Measurement'[Global Status] = "All missing"), 0)
		formatString: #,##0
		displayFolder: Analysis
		lineageTag: 92305daa-86c6-4087-ae0c-27cd3e92abc0

	/// One-based original column index.
	column 'Measurement ID'
		dataType: int64
		isHidden
		lineageTag: 7585942f-0df5-4f3c-a36e-f5b77d8a1f4e
		summarizeBy: none
		sourceColumn: Measurement ID

	/// Anonymous source-column label; physical meaning and units are unknown.
	column Measurement
		dataType: string
		lineageTag: f1aad2f6-6cc7-4944-968a-983b06ccd464
		summarizeBy: none
		sourceColumn: Measurement

	/// Variable, Constant or All missing, determined across the full source.
	column 'Global Status'
		dataType: string
		lineageTag: 57106e0e-bd59-4d26-842f-b4ef222f6c1e
		summarizeBy: none
		sourceColumn: Global Status

	/// Full-source minimum retained as a shared histogram boundary.
	column 'Global Minimum'
		dataType: decimal
		isHidden
		lineageTag: 0c7ddab4-41c1-463c-b7eb-8f1155231d3c
		summarizeBy: none
		sourceColumn: Global Minimum

	/// Full-source maximum retained as a shared histogram boundary.
	column 'Global Maximum'
		dataType: decimal
		isHidden
		lineageTag: 1856e0c7-5cb7-40a5-8e21-be036b591ad3
		summarizeBy: none
		sourceColumn: Global Maximum

	partition Measurement = m
		mode: import
		source =
				let
				    Source = Table.RemoveColumns(#"Read Measurements"(), {"Sample ID"}),
				    Columns = List.Buffer(List.Transform(Table.ToColumns(Source), each List.Buffer(List.RemoveNulls(_)))),
				    Profiles = List.Transform({0..589}, (i) => let
				        Values = Columns{i},
				        Minimum = List.Min(Values, null),
				        Maximum = List.Max(Values, null),
				        Status = if List.IsEmpty(Values) then "All missing" else if Minimum = Maximum then "Constant" else "Variable"
				        in {i+1, "Measurement " & Text.PadStart(Text.From(i+1), 3, "0"), Status, Minimum, Maximum}),
				    Result = Table.FromRows(Profiles, type table [#"Measurement ID"=Int64.Type, Measurement=text,
				        #"Global Status"=text, #"Global Minimum"=Currency.Type, #"Global Maximum"=Currency.Type])
				in
				    Result

	annotation PBI_ResultType = Exception

